@startuml
title Cinebridge - implementação
interface RepositorioProfissionais
interface Repositorio
interface ProcessadorEventos
interface PublicadorIntegracao
Repositorio --|> RepositorioProfissionais
class SistemaRecomendacao
class CatalogoProfissionais
class CatalogoHttp
class RepositorioPostgres
class OrquestradorEquipe <<Template Method>>
class OrquestradorPadrao
interface EstrategiaRecomendacao <<Strategy>>
class SimilaridadeCosseno
class FiltragemColaborativa
class RegrasOrcamento
class EventosEmMemoria <<EventEmitter>>
interface Observador
class ObservadorComposicao
class AuditoriaRecomendacao
class NotificadorInterno
class NotificadorEmail
class IntegracaoEquipe
class PublicadorHttp
class Profissional
interface Visitante <<Visitor>>
class ValidadorConsistencia
class CalculadorCompatibilidade
class GeradorRelatorio
RepositorioPostgres ..|> Repositorio
CatalogoHttp ..|> RepositorioProfissionais
SistemaRecomendacao --> Repositorio
SistemaRecomendacao --> ProcessadorEventos
SistemaRecomendacao --> CatalogoProfissionais
CatalogoProfissionais --> RepositorioProfissionais
SistemaRecomendacao --> OrquestradorEquipe
OrquestradorPadrao --|> OrquestradorEquipe
OrquestradorEquipe --> EstrategiaRecomendacao
SimilaridadeCosseno ..|> EstrategiaRecomendacao
FiltragemColaborativa ..|> EstrategiaRecomendacao
RegrasOrcamento ..|> EstrategiaRecomendacao
EventosEmMemoria ..|> ProcessadorEventos
EventosEmMemoria o--> Observador
ObservadorComposicao ..|> Observador
AuditoriaRecomendacao ..|> Observador
NotificadorInterno ..|> Observador
NotificadorEmail ..|> Observador
IntegracaoEquipe ..|> Observador
ObservadorComposicao --> SistemaRecomendacao : aplicarRespostaConvite
IntegracaoEquipe --> PublicadorIntegracao
PublicadorHttp ..|> PublicadorIntegracao
Projeto --> Visitante : aceitar
Profissional --> Visitante : aceitar
ValidadorConsistencia ..|> Visitante
CalculadorCompatibilidade ..|> Visitante
GeradorRelatorio ..|> Visitante
interface Prototipo<T> <<Prototype>> {
  +clonar(): T
}
abstract class "Projeto<R>" as Projeto {
  +tipo: TipoProjeto
  +restricoes: R
  +clonar(): Projeto<R>
  +ajustar(ajustes, restricoes): this
  +comEstado(estado, profissionais): Projeto<R>
}
class ProjetoFiccao
class ProjetoDocumentario
class ProjetoAnimacao
class ProjetoPublicitario
class RegistroPrototipos {
  -prototipos: Map<TipoProjeto, Projeto>
  +registrar(prototipo): this
  +obter(tipo): Projeto
  +criar(tipo, ajustes): Projeto
  +hidratar(estado, profissionais): Projeto
}
Projeto ..|> Prototipo
Profissional ..|> Prototipo
ProjetoFiccao --|> Projeto
ProjetoDocumentario --|> Projeto
ProjetoAnimacao --|> Projeto
ProjetoPublicitario --|> Projeto
RegistroPrototipos "1" o--> "0..*" Projeto : clona
SistemaRecomendacao --> RegistroPrototipos
interface FabricaProjeto <<Abstract Factory>> {
  +tipo: TipoProjeto
  +criarProjeto(dados): Projeto
  +criarValidador(): ValidadorProjeto
  +criarRecomendador(estrategia): EstrategiaRecomendacao
  +criarNotificador(): NotificadorProjeto
  +criarRelatorio(): Visitante
}
class GeradorRelatorioAnimacao
GeradorRelatorioAnimacao --|> GeradorRelatorio
FabricaAnimacao ..> GeradorRelatorioAnimacao : cria
abstract class FabricaBase
class FabricaFiccao
class FabricaDocumentario
class FabricaAnimacao
class FabricaPublicitario
interface ValidadorProjeto
interface NotificadorProjeto
class RecomendadorPriorizado
FabricaBase ..|> FabricaProjeto
FabricaFiccao --|> FabricaBase
FabricaDocumentario --|> FabricaBase
FabricaAnimacao --|> FabricaBase
FabricaPublicitario --|> FabricaBase
FabricaBase --> Projeto : prototipo
Projeto ..> FabricaProjeto : criarFabrica() <<Factory Method>>
FabricaProjeto ..> ValidadorProjeto : cria
FabricaProjeto ..> NotificadorProjeto : cria
FabricaProjeto ..> EstrategiaRecomendacao : cria
RecomendadorPriorizado ..|> EstrategiaRecomendacao
RecomendadorPriorizado --> EstrategiaRecomendacao : base
OrquestradorEquipe --> "1" FabricaProjeto
SistemaRecomendacao ..> FabricaProjeto : seleciona pelo tipo
note right of Profissional
preco: valor proposto
faixaPreco: mínimo e máximo
competências, avaliações,
disponibilidade e histórico
end note
note bottom of CatalogoHttp
HTTP para catálogo com PostgreSQL próprio.
Falha: cache recente ou equipe parcial.
end note
note bottom of PublicadorHttp
EQUIPE_FORMADA para projetos e financeiro.
Repetição com chave de idempotência.
end note
@enduml
